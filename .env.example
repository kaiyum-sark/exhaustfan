# Postgres connection string (Supabase project settings → Database).
# Used for anything that connects outside the Supabase client libraries
# (e.g. migration tooling).
DATABASE_URL=

# Supabase project URL and anon key, server-side names (SYSTEM_ARCHITECTURE.md §1).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Same two values, exposed to the browser bundle. Next.js only inlines
# NEXT_PUBLIC_* variables into client code, so lib/supabase/client.ts and
# middleware.ts read these instead of the server-only names above. Same
# values as SUPABASE_URL / SUPABASE_ANON_KEY — the anon key is safe to
# expose (it only grants what RLS policies allow).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — server-only, bypasses RLS. Never expose to the client,
# never prefix with NEXT_PUBLIC_. Used only by lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Used only by scripts/seed-super-admin.mjs (one-time/rerunnable provisioning
# script) — not read by the app at runtime. Do not commit real values.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=
